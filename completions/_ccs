#compdef ccs

# Zsh completion for ccs.
# Hidden test/helper mode:
#   completions/_ccs --rows [--app <type>]
# prints the same provider rows used by completion.

_ccs_rows() {
  local app="${1:-claude}"
  ccs --completion-rows --app "$app" 2>/dev/null
}

if [[ "${1:-}" == "--rows" ]]; then
  _ccs_rows "${2:-claude}"
  return $?
fi

_ccs() {
  local -a _ccs_app_types
  _ccs_app_types=(
    'claude:Launch with Claude provider'
    'codex:Launch with Codex provider'
    'codex-sync-sessions:Flip Codex sessions (DB + JSONL) to a provider'
  )

  if (( CURRENT == 2 )); then
    # First argument: app type keywords + claude provider names (backward compat)
    local -a names descriptions
    local line name current detail

    # Add app type keywords
    _describe 'app type' _ccs_app_types

    # Add claude provider names
    while IFS=$'\t' read -r name current detail; do
      [[ -n "$name" ]] || continue
      names+=("$name")
      descriptions+=("$current | $detail")
    done < <(_ccs_rows claude)

    compadd -M 'm:{a-zA-Z}={A-Za-z}' -d descriptions -- "${names[@]}"
    return
  fi

  if (( CURRENT == 3 )); then
    local word="${words[2]}"
    case "$word" in
      codex-sync-sessions)
        # Complete with state-DB provider values + --dry-run flag
        local -a opts
        local p
        while IFS= read -r p; do
          [[ -n "$p" ]] && opts+=("$p")
        done < <(_ccs_rows codex-sync-sessions)
        opts+=("--dry-run")
        compadd -- "${opts[@]}"
        return
        ;;
      claude)
        # Complete claude provider names
        local -a names descriptions
        local line name current detail
        while IFS=$'\t' read -r name current detail; do
          [[ -n "$name" ]] || continue
          names+=("$name")
          descriptions+=("$current | $detail")
        done < <(_ccs_rows claude)
        compadd -M 'm:{a-zA-Z}={A-Za-z}' -d descriptions -- "${names[@]}"
        return
        ;;
      codex)
        # Complete codex provider names
        local -a names descriptions
        local line name current detail
        while IFS=$'\t' read -r name current detail; do
          [[ -n "$name" ]] || continue
          names+=("$name")
          descriptions+=("$current | $detail")
        done < <(_ccs_rows codex)
        compadd -M 'm:{a-zA-Z}={A-Za-z}' -d descriptions -- "${names[@]}"
        return
        ;;
    esac
  fi

  # No more completions
  return
}

_ccs "$@"